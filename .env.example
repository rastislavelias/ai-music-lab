# Host port for the browser UI
WEB_PORT=3000

# Pinned official ACE-Step release. Upgrade deliberately after reviewing release notes.
ACESTEP_IMAGE=ghcr.io/ace-step/ace-step-1.5:0.1.8
ACESTEP_CONFIG_PATH=acestep-v15-turbo
# 4B is the official default but needs substantial VRAM. For 6-8 GB use acestep-5Hz-lm-0.6B.
ACESTEP_LM_MODEL_PATH=acestep-5Hz-lm-4B
ACESTEP_LLM_BACKEND=pt
ACESTEP_EXTRA_ARGS=

# Worker tuning
WORKER_POLL_MS=5000
WORKER_TASK_TIMEOUT_MS=3600000

# Local cover generation. Z-Image-Turbo is Apache-2.0, ungated, and designed
# to fit 16 GB consumer GPUs. See docs/IMAGE_MODELS.md before changing models.
IMAGE_MODEL_ID=Tongyi-MAI/Z-Image-Turbo
IMAGE_OFFLOAD_MODE=sequential
IMAGE_INFERENCE_STEPS=9
IMAGE_GUIDANCE_SCALE=0
IMAGE_TASK_TIMEOUT_MS=3600000
