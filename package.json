{
  "name": "ai-music-lab",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.20.0",
  "scripts": {
    "build": "pnpm --filter @ai-music-lab/web build",
    "dev": "pnpm --parallel --filter @ai-music-lab/web --filter @ai-music-lab/worker dev",
    "format:check": "prettier --check .",
    "lint": "pnpm --filter @ai-music-lab/web lint && pnpm --filter @ai-music-lab/worker typecheck",
    "prisma:generate": "pnpm --filter @ai-music-lab/db prisma:generate",
    "prisma:migrate": "pnpm --filter @ai-music-lab/db prisma:migrate",
    "test": "pnpm --filter @ai-music-lab/worker test",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "prettier": "3.6.2",
    "typescript": "5.9.3"
  }
}
